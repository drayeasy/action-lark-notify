{
  "name": "action-lark-notify",
  "version": "0.2.0",
  "private": true,
  "description": "A GitHub action to notify in Lark.",
  "keywords": [
    "GitHub",
    "Actions",
    "JavaScript",
    "Lark"
  ],
  "homepage": "https://github.com/drayeasy/action-lark-notify#readme",
  "bugs": {
    "url": "https://github.com/drayeasy/action-lark-notify/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drayeasy/action-lark-notify.git"
  },
  "license": "MIT",
  "author": {
    "name": "Ray Wu",
    "email": "ray.wu@drayeasy.com"
  },
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsx ./scripts/build.ts",
    "build:watch": "tsx ./scripts/build.ts --watch",
    "check": "biome check --write . && tsc --noEmit",
    "local": "local-action . src/main.ts .env",
    "make-badge": "tsx ./scripts/make-badge.ts",
    "prepare": "is-ci || lefthook install",
    "release": "release-it",
    "preversion": "pnpm run check && pnpm run build",
    "postversion": "pnpm run make-badge"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/http-client": "^4.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.4",
    "@github/local-action": "^7.0.1",
    "@release-it/conventional-changelog": "^11.0.1",
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.13.3",
    "badge-maker": "^6.0.0",
    "esbuild": "^0.28.1",
    "is-ci": "^4.1.0",
    "lefthook": "^2.1.10",
    "release-it": "^20.2.1",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=24"
  }
}
